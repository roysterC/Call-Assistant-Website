# Kikai's own chat widget, served by the CRM. Leave both empty to hide it.
# The site id comes from the CRM: Websites → (this site) → embed code.
NEXT_PUBLIC_KIKAI_CRM_ORIGIN=https://89-58-45-110.nip.io
NEXT_PUBLIC_KIKAI_WIDGET_SITE_ID=

# Where "Book a 30-min call" goes (e.g. a Cal.com link). Empty sends people to /start.
NEXT_PUBLIC_BOOKING_URL=

# Canonical URL, used for metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://kikai.example
